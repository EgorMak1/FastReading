<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.Trainings.RunningWordsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Бегущие слова">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Label
                FontAttributes="Bold"
                FontSize="28"
                HorizontalOptions="Center"
                Text="Бегущие слова" />

            <Label
                x:Name="DifficultyLabel"
                FontSize="16"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                TextColor="#5C6BC0" />

            <Frame
                Padding="20"
                BorderColor="LightGray"
                CornerRadius="12">

                <VerticalStackLayout Spacing="12">

                    <Label
                        x:Name="CurrentWordLabel"
                        FontAttributes="Bold"
                        FontSize="24"
                        HorizontalOptions="Center"
                        Text="Нажмите старт" />

                    <Label
                        x:Name="StatusLabel"
                        FontSize="14"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="Подготовка к раунду." />
                </VerticalStackLayout>
            </Frame>

            <Label
                FontAttributes="Bold"
                FontSize="18"
                Text="Варианты ответа:" />

            <Button x:Name="AnswerButton1" Clicked="OnAnswerClicked" Text="Вариант 1" />
            <Button x:Name="AnswerButton2" Clicked="OnAnswerClicked" Text="Вариант 2" />
            <Button x:Name="AnswerButton3" Clicked="OnAnswerClicked" Text="Вариант 3" />
            <Button x:Name="AnswerButton4" Clicked="OnAnswerClicked" Text="Вариант 4" />

            <Button
                x:Name="StartButton"
                Margin="0,20,0,0"
                Clicked="OnStartClicked"
                Text="Начать упражнение" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
