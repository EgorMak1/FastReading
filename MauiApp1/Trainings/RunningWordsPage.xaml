<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.Trainings.RunningWordsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Бегущие слова">

    <ScrollView
        x:Name="RunningWordsScroll"
        SizeChanged="OnRunningWordsScrollSizeChanged">
        <Grid
            x:Name="RunningWordsContentContainer"
            Padding="16"
            HorizontalOptions="Fill"
            MaximumWidthRequest="720">

            <VerticalStackLayout
                Spacing="12"
                VerticalOptions="Center">

            <Label
                x:Name="DifficultyLabel"
                FontSize="14"
                HorizontalTextAlignment="Center"
                TextColor="#5C6BC0" />

            <Frame
                Padding="16"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2B2B2B}"
                BorderColor="{AppThemeBinding Light=LightGray, Dark=#5A5A5A}"
                CornerRadius="10">

                <VerticalStackLayout Spacing="10">

                    <Label
                        x:Name="CurrentWordLabel"
                        FontAttributes="Bold"
                        FontSize="24"
                        HorizontalOptions="Center"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                        Text="Нажмите старт" />

                    <Label
                        x:Name="StatusLabel"
                        FontSize="13"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"
                        Text="Подготовка к раунду." />
                </VerticalStackLayout>
            </Frame>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10"
                RowDefinitions="Auto,Auto"
                RowSpacing="10">
                <Button
                    x:Name="AnswerButton1"
                    Grid.Row="0"
                    Grid.Column="0"
                    Clicked="OnAnswerClicked"
                    Text="Вариант 1" />
                <Button
                    x:Name="AnswerButton2"
                    Grid.Row="0"
                    Grid.Column="1"
                    Clicked="OnAnswerClicked"
                    Text="Вариант 2" />
                <Button
                    x:Name="AnswerButton3"
                    Grid.Row="1"
                    Grid.Column="0"
                    Clicked="OnAnswerClicked"
                    Text="Вариант 3" />
                <Button
                    x:Name="AnswerButton4"
                    Grid.Row="1"
                    Grid.Column="1"
                    Clicked="OnAnswerClicked"
                    Text="Вариант 4" />
            </Grid>

            <Button
                x:Name="StartButton"
                Clicked="OnStartClicked"
                Text="Начать" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
