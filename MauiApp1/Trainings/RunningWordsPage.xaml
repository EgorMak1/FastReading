<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.Trainings.RunningWordsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Бегущие слова">

    <ScrollView>
        <VerticalStackLayout
            Padding="16"
            Spacing="12">

            <Label
                x:Name="DifficultyLabel"
                FontSize="14"
                HorizontalTextAlignment="Center"
                TextColor="#5C6BC0" />

            <Frame
                Padding="16"
                BorderColor="LightGray"
                CornerRadius="10">

                <VerticalStackLayout Spacing="10">

                    <Label
                        x:Name="CurrentWordLabel"
                        FontAttributes="Bold"
                        FontSize="24"
                        HorizontalOptions="Center"
                        Text="Нажмите старт" />

                    <Label
                        x:Name="StatusLabel"
                        FontSize="13"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="Подготовка к раунду." />
                </VerticalStackLayout>
            </Frame>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10"
                RowDefinitions="Auto,Auto"
                RowSpacing="10">
                <Button
                    x:Name="AnswerButton1"
                    Grid.Row="0"
                    Grid.Column="0"
                    Clicked="OnAnswerClicked"
                    Text="Вариант 1" />
                <Button
                    x:Name="AnswerButton2"
                    Grid.Row="0"
                    Grid.Column="1"
                    Clicked="OnAnswerClicked"
                    Text="Вариант 2" />
                <Button
                    x:Name="AnswerButton3"
                    Grid.Row="1"
                    Grid.Column="0"
                    Clicked="OnAnswerClicked"
                    Text="Вариант 3" />
                <Button
                    x:Name="AnswerButton4"
                    Grid.Row="1"
                    Grid.Column="1"
                    Clicked="OnAnswerClicked"
                    Text="Вариант 4" />
            </Grid>

            <Button
                x:Name="StartButton"
                Clicked="OnStartClicked"
                Text="Начать" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
