<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.Trainings.ShulteTablePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Таблица Шульте">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label
                x:Name="DifficultyLabel"
                FontSize="15"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                TextColor="#B39DDB" />

            <Label
                x:Name="SessionStatsLabel"
                FontSize="13"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                TextColor="Gray" />

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10">
                <Label
                    x:Name="NextNumberLabel"
                    Grid.Column="0"
                    FontAttributes="Bold"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Text="Найди: 1" />

                <Label
                    x:Name="TimerLabel"
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="20"
                    HorizontalTextAlignment="Center" />
            </Grid>

            <Grid
                x:Name="ShulteTableGrid"
                ColumnSpacing="8"
                HorizontalOptions="Fill"
                RowSpacing="8"
                VerticalOptions="Fill" />

            <Button
                BackgroundColor="Red"
                Clicked="OnFinishTrainingClicked"
                Text="Завершить"
                TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
