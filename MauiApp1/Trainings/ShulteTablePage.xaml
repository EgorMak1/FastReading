<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Trainings.ShulteTablePage"
             Title="Таблица Шульте">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Таблица Шульте"
                   FontSize="32"
                   HorizontalOptions="Center" />

            <Label x:Name="DifficultyLabel"
                   FontSize="18"
                   HorizontalOptions="Center"
                   TextColor="#B39DDB" />

            <Label x:Name="SessionStatsLabel"
                   FontSize="14"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="Gray" />

            <VerticalStackLayout x:Name="DebugActionsLayout"
                                 Spacing="8">
                <Label Text="Инструменты разработки"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#5C6BC0" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Смоделировать повышение"
                            BackgroundColor="#43A047"
                            TextColor="White"
                            HorizontalOptions="Fill"
                            Clicked="OnSimulateLevelUpClicked" />
                    <Button Text="Смоделировать понижение"
                            BackgroundColor="#E53935"
                            TextColor="White"
                            HorizontalOptions="Fill"
                            Clicked="OnSimulateLevelDownClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Label x:Name="NextNumberLabel"
                   Text="Найди: 1"
                   FontSize="24"
                   HorizontalOptions="Center" />

            <Label x:Name="TimerLabel"
                   FontSize="24"
                   HorizontalOptions="Center" />

            <Grid x:Name="ShulteTableGrid"
                  RowSpacing="8"
                  ColumnSpacing="8"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill" />

            <Button Text="Завершить тренировку"
                    BackgroundColor="Red"
                    TextColor="White"
                    Clicked="OnFinishTrainingClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
