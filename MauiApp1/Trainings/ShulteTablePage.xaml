<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.Trainings.ShulteTablePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Таблица Шульте">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label
                FontSize="32"
                HorizontalOptions="Center"
                Text="Таблица Шульте" />

            <Label
                x:Name="DifficultyLabel"
                FontSize="18"
                HorizontalOptions="Center"
                TextColor="#B39DDB" />

            <Label
                x:Name="SessionStatsLabel"
                FontSize="14"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                TextColor="Gray" />

            <VerticalStackLayout
                x:Name="DebugActionsLayout"
                Spacing="8">
                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Инструменты разработки"
                    TextColor="#5C6BC0" />
                <HorizontalStackLayout Spacing="8">
                    <Button
                        BackgroundColor="#43A047"
                        Clicked="OnSimulateLevelUpClicked"
                        HorizontalOptions="Fill"
                        Text="Смоделировать повышение"
                        TextColor="White" />
                    <Button
                        BackgroundColor="#E53935"
                        Clicked="OnSimulateLevelDownClicked"
                        HorizontalOptions="Fill"
                        Text="Смоделировать понижение"
                        TextColor="White" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Label
                x:Name="NextNumberLabel"
                FontSize="24"
                HorizontalOptions="Center"
                Text="Найди: 1" />

            <Label
                x:Name="TimerLabel"
                FontSize="24"
                HorizontalOptions="Center" />

            <Grid
                x:Name="ShulteTableGrid"
                ColumnSpacing="8"
                HorizontalOptions="Fill"
                RowSpacing="8"
                VerticalOptions="Fill" />

            <Button
                BackgroundColor="Red"
                Clicked="OnFinishTrainingClicked"
                Text="Завершить тренировку"
                TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
