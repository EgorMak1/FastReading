<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.Trainings.ExerciseSelectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:MauiApp1.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    Title="Тренировки">

    <Grid RowDefinitions="*,Auto">
        <ScrollView
            x:Name="ExerciseSelectionScroll"
            Grid.Row="0"
            SizeChanged="OnExerciseSelectionScrollSizeChanged">
            <Grid
                x:Name="ExerciseSelectionContentContainer"
                Padding="24"
                HorizontalOptions="Center"
                MaximumWidthRequest="1040">

                <VerticalStackLayout
                    Spacing="14"
                    VerticalOptions="Center">
                    <Border
                        HeightRequest="132"
                        Padding="18"
                        BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#172554}"
                        Stroke="{AppThemeBinding Light=#BFDBFE, Dark=#1D4ED8}"
                        StrokeShape="RoundRectangle 8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRunningWordsTapped" />
                        </Border.GestureRecognizers>
                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,*"
                            ColumnSpacing="14">
                            <Label
                                Grid.ColumnSpan="2"
                                LineBreakMode="NoWrap"
                                MaxLines="1"
                                Style="{StaticResource SectionTitle}"
                                Text="Бегущие слова" />
                            <Label
                                Grid.Row="1"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Style="{StaticResource MutedText}"
                                Text="Быстрый выбор последнего слова." />

                            <Grid
                                Grid.Row="1"
                                Grid.Column="1"
                                ColumnDefinitions="70,92"
                                ColumnSpacing="10"
                                WidthRequest="{OnIdiom Phone=172, Tablet=172, Desktop=-1}"
                                VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        Style="{StaticResource MutedText}"
                                        Text="Точность" />
                                    <Label
                                        x:Name="RunningWordsAccuracyLabel"
                                        FontAttributes="Bold"
                                        FontSize="{OnIdiom Phone=16, Tablet=17, Desktop=18}"
                                        LineBreakMode="NoWrap"
                                        Text="Нет данных" />
                                </VerticalStackLayout>
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2">
                                    <Label
                                        Style="{StaticResource MutedText}"
                                        Text="Рекорд" />
                                    <Label
                                        x:Name="RunningWordsRecordLabel"
                                        FontAttributes="Bold"
                                        FontSize="{OnIdiom Phone=16, Tablet=17, Desktop=18}"
                                        LineBreakMode="NoWrap"
                                        Text="Нет данных" />
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border
                        HeightRequest="132"
                        Padding="18"
                        BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#052E2B}"
                        Stroke="{AppThemeBinding Light=#A7F3D0, Dark=#047857}"
                        StrokeShape="RoundRectangle 8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShulteTableTapped" />
                        </Border.GestureRecognizers>
                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,*"
                            ColumnSpacing="14">
                            <Label
                                Grid.ColumnSpan="2"
                                LineBreakMode="NoWrap"
                                MaxLines="1"
                                Style="{StaticResource SectionTitle}"
                                Text="Таблица Шульте" />
                            <Label
                                Grid.Row="1"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Style="{StaticResource MutedText}"
                                Text="Поиск чисел и устойчивость взгляда." />

                            <Grid
                                Grid.Row="1"
                                Grid.Column="1"
                                ColumnDefinitions="70,92"
                                ColumnSpacing="10"
                                WidthRequest="{OnIdiom Phone=172, Tablet=172, Desktop=-1}"
                                VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        Style="{StaticResource MutedText}"
                                        Text="Точность" />
                                    <Label
                                        x:Name="ShulteAccuracyLabel"
                                        FontAttributes="Bold"
                                        FontSize="{OnIdiom Phone=16, Tablet=17, Desktop=18}"
                                        LineBreakMode="NoWrap"
                                        Text="Нет данных" />
                                </VerticalStackLayout>
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2">
                                    <Label
                                        Style="{StaticResource MutedText}"
                                        Text="Рекорд" />
                                    <Label
                                        x:Name="ShulteRecordLabel"
                                        FontAttributes="Bold"
                                        FontSize="{OnIdiom Phone=16, Tablet=17, Desktop=18}"
                                        LineBreakMode="NoWrap"
                                        Text="Нет данных" />
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border
                        HeightRequest="132"
                        Padding="18"
                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}"
                        Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}"
                        StrokeShape="RoundRectangle 8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFieldOfViewTapped" />
                        </Border.GestureRecognizers>
                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,*"
                            ColumnSpacing="14">
                            <Label
                                Grid.ColumnSpan="2"
                                LineBreakMode="NoWrap"
                                MaxLines="1"
                                Style="{StaticResource SectionTitle}"
                                Text="Поле зрения" />
                            <Label
                                Grid.Row="1"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Style="{StaticResource MutedText}"
                                Text="Реакция на отличия в сетке." />

                            <Grid
                                Grid.Row="1"
                                Grid.Column="1"
                                ColumnDefinitions="70,92"
                                ColumnSpacing="10"
                                WidthRequest="{OnIdiom Phone=172, Tablet=172, Desktop=-1}"
                                VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        Style="{StaticResource MutedText}"
                                        Text="Точность" />
                                    <Label
                                        x:Name="FieldOfViewAccuracyLabel"
                                        FontAttributes="Bold"
                                        FontSize="{OnIdiom Phone=16, Tablet=17, Desktop=18}"
                                        LineBreakMode="NoWrap"
                                        Text="Нет данных" />
                                </VerticalStackLayout>
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2">
                                    <Label
                                        Style="{StaticResource MutedText}"
                                        Text="Рекорд" />
                                    <Label
                                        x:Name="FieldOfViewRecordLabel"
                                        FontAttributes="Bold"
                                        FontSize="{OnIdiom Phone=16, Tablet=17, Desktop=18}"
                                        LineBreakMode="NoWrap"
                                        Text="Нет данных" />
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border
                        HeightRequest="132"
                        Padding="18"
                        BackgroundColor="{AppThemeBinding Light=#FFF7ED, Dark=#431407}"
                        Stroke="{AppThemeBinding Light=#FED7AA, Dark=#C2410C}"
                        StrokeShape="RoundRectangle 8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnWordErasingTapped" />
                        </Border.GestureRecognizers>
                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,*"
                            ColumnSpacing="14">
                            <Label
                                Grid.ColumnSpan="2"
                                LineBreakMode="NoWrap"
                                MaxLines="1"
                                Style="{StaticResource SectionTitle}"
                                Text="Стирание слов" />
                            <Label
                                Grid.Row="1"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Style="{StaticResource MutedText}"
                                Text="Чтение исчезающего текста." />

                            <Grid
                                Grid.Row="1"
                                Grid.Column="1"
                                ColumnDefinitions="70,92"
                                ColumnSpacing="10"
                                WidthRequest="{OnIdiom Phone=172, Tablet=172, Desktop=-1}"
                                VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        Style="{StaticResource MutedText}"
                                        Text="Точность" />
                                    <Label
                                        x:Name="WordErasingAccuracyLabel"
                                        FontAttributes="Bold"
                                        FontSize="{OnIdiom Phone=16, Tablet=17, Desktop=18}"
                                        LineBreakMode="NoWrap"
                                        Text="Нет данных" />
                                </VerticalStackLayout>
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2">
                                    <Label
                                        Style="{StaticResource MutedText}"
                                        Text="Рекорд" />
                                    <Label
                                        x:Name="WordErasingRecordLabel"
                                        FontAttributes="Bold"
                                        FontSize="{OnIdiom Phone=16, Tablet=17, Desktop=18}"
                                        LineBreakMode="NoWrap"
                                        Text="Нет данных" />
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <controls:BottomNavigationBar
            Grid.Row="1"
            ActiveTab="Training"
            Margin="24,0,24,16" />
    </Grid>
</ContentPage>
