<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.Trainings.ExerciseSelectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Упражнения">

    <VerticalStackLayout
        HorizontalOptions="Center"
        Padding="20"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            FontSize="32"
            HorizontalOptions="Center"
            Text="Выберите упражнение"
            VerticalOptions="Center" />

        <Button
            BackgroundColor="DodgerBlue"
            Clicked="OnShulteTableClicked"
            Text="Таблица Шульте"
            TextColor="White" />

        <Button
            Clicked="OnRunningWordsClicked"
            Text="Бегущие слова" />

        <Button
            Clicked="OnFieldOfViewClicked"
            Text="Поле зрения" />

        <Button
            Clicked="OnWordErasingClicked"
            Text="Затирание слов" />
    </VerticalStackLayout>
</ContentPage>
