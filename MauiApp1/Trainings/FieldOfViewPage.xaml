<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.Trainings.FieldOfViewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Поле зрения">

    <ScrollView
        x:Name="FieldOfViewScroll"
        SizeChanged="OnFieldOfViewScrollSizeChanged">
        <VerticalStackLayout
            x:Name="FieldOfViewContentContainer"
            Padding="16"
            HorizontalOptions="Fill"
            MaximumWidthRequest="720"
            Spacing="12"
            VerticalOptions="Center">

            <Label
                x:Name="DifficultyLabel"
                FontSize="14"
                HorizontalTextAlignment="Center"
                TextColor="#5C6BC0" />

            <Frame
                Padding="10"
                BorderColor="LightGray"
                CornerRadius="10"
                HorizontalOptions="Center">

                <Grid
                    x:Name="FieldGrid"
                    ColumnSpacing="4"
                    HeightRequest="320"
                    RowSpacing="4"
                    WidthRequest="320" />
            </Frame>

            <Label
                x:Name="StatusLabel"
                FontAttributes="Bold"
                FontSize="15"
                HorizontalTextAlignment="Center"
                Text="Нажмите «Начать»." />

            <Label
                x:Name="StatsLabel"
                FontSize="13"
                HorizontalTextAlignment="Center"
                Text="Уровень: 1, поле: 5x5, интервал: 1800 мс. Раундов: 0, верных: 0." />

            <Grid
                x:Name="ActionButtonsGrid"
                ColumnDefinitions="*,*"
                ColumnSpacing="10"
                HorizontalOptions="Center">
                <Button
                    x:Name="StartButton"
                    Grid.Column="0"
                    Clicked="OnStartClicked"
                    Text="Начать" />

                <Button
                    x:Name="StopButton"
                    Grid.Column="1"
                    Clicked="OnStopClicked"
                    IsEnabled="False"
                    Text="Стоп" />
            </Grid>

            <Button
                x:Name="ErrorButton"
                BackgroundColor="#D9534F"
                Clicked="OnErrorClicked"
                FontAttributes="Bold"
                FontSize="18"
                HeightRequest="56"
                HorizontalOptions="Center"
                IsEnabled="False"
                Text="Ошибка"
                TextColor="White" />

            <Button
                x:Name="ReadyButton"
                Clicked="OnReadyClicked"
                HorizontalOptions="Center"
                IsVisible="False"
                Text="Готов" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
