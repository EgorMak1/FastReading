<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="MauiApp1.Statistics.ShulteStatisticsPage"
             Title="Статистика Таблицы Шульте">
    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Моя статистика"
               FontSize="24"
               HorizontalOptions="Center" />

        <Label Text="Время прохождения (секунды)"
               FontSize="14"
               HorizontalOptions="Center"
               TextColor="Gray" />

        <lvc:CartesianChart x:Name="Chart"
                            HeightRequest="300"
                            HorizontalOptions="Fill" />

        <Label x:Name="BestResultLabel"
               FontSize="16"
               HorizontalOptions="Center" />

        <Label x:Name="AverageResultLabel"
               FontSize="16"
               HorizontalOptions="Center" />

        <Label x:Name="TotalTrainingsLabel"
               FontSize="16"
               HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>