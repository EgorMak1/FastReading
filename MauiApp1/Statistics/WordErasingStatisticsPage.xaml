<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Statistics.WordErasingStatisticsPage"
             Title="Статистика: Затирание слов">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Моя статистика"
                   FontSize="24"
                   HorizontalOptions="Center" />

            <Label Text="Скорость упражнения Затирание слов"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="Gray" />

            <GraphicsView x:Name="ChartView"
                          HeightRequest="300"
                          HorizontalOptions="Fill" />

            <Label x:Name="CurrentSpeedLabel"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label x:Name="LastAttemptLabel"
                   FontSize="16"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="SpeedChangeLabel"
                   FontSize="16"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="NextSpeedLabel"
                   FontSize="16"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="TotalAttemptsLabel"
                   FontSize="16"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
