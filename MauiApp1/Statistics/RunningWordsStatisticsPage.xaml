<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Statistics.RunningWordsStatisticsPage"
             Title="Статистика: Бегущие слова">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Моя статистика"
                   FontSize="24"
                   HorizontalOptions="Center" />

            <Label Text="Результаты упражнения Бегущие слова"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="Gray" />

            <GraphicsView x:Name="ChartView"
                          HeightRequest="300"
                          HorizontalOptions="Fill" />

            <Label x:Name="BestResultLabel"
                   FontSize="16"
                   HorizontalOptions="Center" />

            <Label x:Name="AverageResultLabel"
                   FontSize="16"
                   HorizontalOptions="Center" />

            <Label x:Name="TotalTrainingsLabel"
                   FontSize="16"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>