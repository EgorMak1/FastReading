<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Statistics.RunningWordsStatisticsPage"
             Title="Статистика: Бегущие слова">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Статистика упражнения «Бегущие слова»"
                   FontSize="24"
                   HorizontalOptions="Center" />

            <Label x:Name="SummaryLabel"
                   FontSize="14"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="Gray" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Grid.Row="0" Grid.Column="0" Stroke="#D0D0D0" StrokeThickness="1" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Лучшая точность" FontAttributes="Bold" />
                        <Label x:Name="BestResultLabel" FontSize="20" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Stroke="#D0D0D0" StrokeThickness="1" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Средняя точность" FontAttributes="Bold" />
                        <Label x:Name="AverageResultLabel" FontSize="20" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Stroke="#D0D0D0" StrokeThickness="1" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Текущая скорость" FontAttributes="Bold" />
                        <Label x:Name="CurrentSpeedLabel" FontSize="20" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Stroke="#D0D0D0" StrokeThickness="1" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Самая высокая скорость" FontAttributes="Bold" />
                        <Label x:Name="BestSpeedLabel" FontSize="20" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="2" Grid.Column="0" Stroke="#D0D0D0" StrokeThickness="1" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Всего прохождений" FontAttributes="Bold" />
                        <Label x:Name="TotalTrainingsLabel" FontSize="20" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Stroke="#D0D0D0" StrokeThickness="1" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Средняя скорость" FontAttributes="Bold" />
                        <Label x:Name="AverageSpeedLabel" FontSize="20" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="Динамика точности по попыткам"
                   FontSize="18"
                   FontAttributes="Bold" />

            <GraphicsView x:Name="ChartView"
                          HeightRequest="180"
                          HorizontalOptions="Fill" />

            <Label x:Name="LastSessionLabel"
                   FontSize="15" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
