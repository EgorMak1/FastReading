<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.Profile.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:MauiApp1.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Профиль">

    <Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
        <Grid
            Padding="24"
            HorizontalOptions="Center"
            MaximumWidthRequest="980">

            <VerticalStackLayout Spacing="18">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Style="{StaticResource Headline}"
                            Text="Профиль" />
                        <Label
                            x:Name="SummaryLabel"
                            Style="{StaticResource SubHeadline}" />
                    </VerticalStackLayout>
                </Border>

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="14"
                    RowDefinitions="Auto,Auto,Auto"
                    RowSpacing="14">
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Style="{StaticResource MutedText}"
                                Text="Общий score" />
                            <Label
                                x:Name="OverallScoreLabel"
                                Style="{StaticResource MetricValue}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Style="{StaticResource MutedText}"
                                Text="Очки сегодня" />
                            <Label
                                x:Name="TodayPointsLabel"
                                Style="{StaticResource MetricValue}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Style="{StaticResource MutedText}"
                                Text="Всего сессий" />
                            <Label
                                x:Name="TotalSessionsLabel"
                                Style="{StaticResource MetricValue}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Style="{StaticResource MutedText}"
                                Text="Упражнений" />
                            <Label
                                x:Name="ExercisesTrackedLabel"
                                Style="{StaticResource MetricValue}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Style="{StaticResource MutedText}"
                                Text="Состояние обучения" />
                            <Label
                                x:Name="ReadinessLabel"
                                FontAttributes="Bold"
                                FontSize="22"
                                TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Style="{StaticResource SectionTitle}"
                            Text="Аналитика" />
                        <Label
                            x:Name="InsightsLabel"
                            Style="{StaticResource MutedText}" />
                        <Label
                            x:Name="RecommendationLabel"
                            TextColor="{StaticResource Primary}"
                            FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <Label
                    Style="{StaticResource SectionTitle}"
                    Text="Прогресс по упражнениям" />

                <VerticalStackLayout
                    x:Name="ExerciseProgressContainer"
                    Spacing="12" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
    <controls:BottomNavigationBar
        Grid.Row="1"
        ActiveTab="Profile"
        Margin="24,0,24,16" />
    </Grid>
</ContentPage>
