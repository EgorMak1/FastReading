<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Profile.ProfilePage"
             Title="Профиль">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Профиль пользователя"
                   FontSize="28"
                   HorizontalOptions="Center" />

            <Label x:Name="SummaryLabel"
                   FontSize="16"
                   HorizontalTextAlignment="Center"
                   TextColor="Gray" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Grid.Row="0" Grid.Column="0" Stroke="#D0D0D0" StrokeThickness="1" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Общий score" FontAttributes="Bold" />
                        <Label x:Name="OverallScoreLabel" FontSize="22" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Stroke="#D0D0D0" StrokeThickness="1" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Очки за сегодня" FontAttributes="Bold" />
                        <Label x:Name="TodayPointsLabel" FontSize="22" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Stroke="#D0D0D0" StrokeThickness="1" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Всего сессий" FontAttributes="Bold" />
                        <Label x:Name="TotalSessionsLabel" FontSize="22" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Stroke="#D0D0D0" StrokeThickness="1" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Упражнений отслеживается" FontAttributes="Bold" />
                        <Label x:Name="ExercisesTrackedLabel" FontSize="22" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="2" Grid.ColumnSpan="2" Stroke="#D0D0D0" StrokeThickness="1" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Состояние обучения" FontAttributes="Bold" />
                        <Label x:Name="ReadinessLabel" FontSize="20" TextColor="#5C6BC0" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Stroke="#D0D0D0" StrokeThickness="1" Padding="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Аналитика" FontSize="20" FontAttributes="Bold" />
                    <Label x:Name="InsightsLabel"
                           FontSize="15"
                           TextColor="#5C6BC0" />
                    <Label x:Name="RecommendationLabel"
                           FontSize="15"
                           TextColor="#455A64" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Прогресс по упражнениям"
                   FontSize="20"
                   FontAttributes="Bold" />

            <VerticalStackLayout x:Name="ExerciseProgressContainer"
                                 Spacing="10" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
